<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OATControl.Avalonia"
        x:Class="OATControl.Avalonia.DlgRunPolarAlignment"
        x:DataType="local:DlgRunPolarAlignment"
        Title="Polar Alignment" Width="560" Height="230"
        CanResize="False" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.step">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Width" Value="100"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="10,8"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
  </Window.Styles>

  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- Step 1: confirm home position -->
    <TextBlock Grid.Row="0" Classes="step"
               Text="Is the mount at the home position?"
               IsVisible="{Binding IsStep1}"/>
    <Button Grid.Row="0" Classes="action" Content="Yes"
            Command="{Binding OKCommand}"
            IsVisible="{Binding IsStep1}"
            HorizontalAlignment="Right"/>

    <!-- Step 2: slewing, then centre Polaris -->
    <TextBlock Grid.Row="1" Classes="step"
               Text="Wait for slewing to stop, then move the mount so that Polaris is centred in your camera's viewfinder."
               IsVisible="{Binding IsStep2}"/>
    <Button Grid.Row="1" Classes="action" Content="Done"
            Command="{Binding OKCommand}"
            IsVisible="{Binding IsStep2}"
            HorizontalAlignment="Right"/>

    <!-- Step 3: complete -->
    <TextBlock Grid.Row="2" Classes="step"
               Text="Your mount is now polar aligned."
               IsVisible="{Binding IsStep3}"/>

    <!-- Always-visible Close/Cancel -->
    <Button Grid.Row="5" Classes="action" Content="Close"
            Command="{Binding CloseCommand}"
            HorizontalAlignment="Right"/>
  </Grid>
</Window>
