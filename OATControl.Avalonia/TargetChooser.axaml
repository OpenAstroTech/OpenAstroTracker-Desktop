<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OATControl.ViewModels"
        x:Class="OATControl.Avalonia.TargetChooser"
        x:DataType="vm:MountVM"
        Title="Target Chooser"
        Width="560"
        Height="620"
        MinWidth="260"
        MinHeight="320"
        Background="#120606">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#2A0E0E"/>
      <Setter Property="BorderBrush" Value="#5C1A1A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#F08A77"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#C98A82"/>
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#F8D8CE"/>
    </Style>

    <Style Selector="ListBox.poiList">
      <Setter Property="Background" Value="#1F0B0B"/>
      <Setter Property="BorderBrush" Value="#6B2222"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="Choose a target from the enabled points of interest"/>
    </Border>

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,10">
      <ListBox Classes="poiList"
               ItemsSource="{Binding AvailablePointsOfInterest}"
               SelectedItem="{Binding SelectedPointOfInterest, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="78,*,95,95,70" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="value" Text="{Binding CatalogName}"/>
              <TextBlock Grid.Column="1" Classes="value" Text="{Binding Name}"/>
              <TextBlock Grid.Column="2" Classes="value" Text="{Binding RA, StringFormat='RA {0:0.000}'}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Classes="value" Text="{Binding DEC, StringFormat='DEC {0:0.000}'}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Classes="value" Text="{Binding Distance, StringFormat='D {0:0.0}'}" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock Grid.Row="2"
               HorizontalAlignment="Center"
               Classes="label"
               Text="Selecting a row updates target RA/DEC in the main window."/>
  </Grid>
</Window>