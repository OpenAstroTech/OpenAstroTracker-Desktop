<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:e="clr-namespace:OATTest.Converters"
        xmlns:local="clr-namespace:OATTest"
        x:Class="OATTest.MainWindow"
        x:DataType="local:TestVM"
        Title="{Binding Version, StringFormat='OpenAstro Test Manager V{0}'}"
        Height="870" Width="900"
        Background="#1E1E1E">
    <Window.Resources>
        <e:SwitchConverter x:Key="StatusIcons">
            <e:SwitchConverterCase When="Ready"    Then="avares://OATTest.Avalonia/Images/clock.png" />
            <e:SwitchConverterCase When="Running"  Then="avares://OATTest.Avalonia/Images/rocket-fly.png" />
            <e:SwitchConverterCase When="Failed"   Then="avares://OATTest.Avalonia/Images/cross-button.png" />
            <e:SwitchConverterCase When="Success"  Then="avares://OATTest.Avalonia/Images/tick-button.png" />
            <e:SwitchConverterCase When="Complete" Then="avares://OATTest.Avalonia/Images/tick-white.png" />
            <e:SwitchConverterCase When="Skipped"  Then="avares://OATTest.Avalonia/Images/arrow-step-over.png" />
        </e:SwitchConverter>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Command port -->
        <TextBlock Grid.Row="0" Text="Command Port" HorizontalAlignment="Right" Margin="0,6,0,5" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" Width="120"
                  ItemsSource="{Binding AvailableDevices}" DisplayMemberBinding="{Binding DeviceName}" SelectedItem="{Binding CommandDevice}"/>
        <ComboBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Margin="10,5,10,0" VerticalAlignment="Top" Width="90"
                  ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding CommandBaudRate}"/>
        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="Rescan Ports" Padding="8,14,8,18" Margin="4,4,4,0"
                VerticalAlignment="Center" Command="{Binding ResetScanDevicesCommand}" IsEnabled="{Binding CanReset}"/>
        <TextBlock Grid.Row="0" Grid.Column="4" Text="Set Date To:" HorizontalAlignment="Right" Margin="30,6,5,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="5" Width="120" Margin="4,6,4,3" Text="{Binding UseDate}" VerticalAlignment="Center"/>
        <Button Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" HorizontalAlignment="Left" Padding="5,12,5,16" Width="50"
                Margin="4,5,4,3" Content="Now" VerticalAlignment="Center" Command="{Binding SetDateTimeToNowCommand}"/>

        <!-- Row 1: Debug port -->
        <CheckBox Grid.Row="1" Content="Separate Debug Port" HorizontalAlignment="Right" Margin="5,6,0,6"
                  VerticalAlignment="Center" x:Name="separatePort" IsChecked="{Binding IsDebugPortSeperate}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" Width="120"
                  ItemsSource="{Binding AvailableDevices}" DisplayMemberBinding="{Binding DeviceName}"
                  SelectedItem="{Binding DebugPort}" IsEnabled="{Binding #separatePort.IsChecked}"/>
        <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Margin="10,5,10,0" VerticalAlignment="Top" Width="90"
                  ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding DebugBaudRate}"
                  IsEnabled="{Binding #separatePort.IsChecked}"/>
        <TextBlock Grid.Row="1" Grid.Column="4" Text="Set Time To:" HorizontalAlignment="Right" Margin="30,6,5,5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="5" Margin="4,6,4,3" Text="{Binding UseTime}" VerticalAlignment="Center"/>

        <!-- Row 2: Options -->
        <CheckBox Grid.Row="2" Grid.Column="0" Content="Stop on Error" HorizontalAlignment="Left" Margin="5,5,0,0"
                  VerticalAlignment="Top" IsChecked="{Binding StopOnError}"/>

        <!-- Row 3: Test suite selector + controls -->
        <Grid Grid.Row="3" Grid.ColumnSpan="7" HorizontalAlignment="Stretch" Margin="5,10,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="161"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Margin="0"
                      ItemsSource="{Binding TestSuites}" SelectedItem="{Binding SelectedTestSuite}"/>
            <Button Grid.Column="3" Content="Reset" Padding="15,2" Margin="5,0" VerticalAlignment="Center"
                    Command="{Binding ResetTestsCommand}" IsEnabled="{Binding CanReset}"/>

            <TextBlock Grid.Row="1" Text="{Binding AppStatus}" VerticalAlignment="Top" Margin="5,3,0,0"
                       FontWeight="Bold" Foreground="#CC3333"/>

            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="Run" Padding="15,2" Margin="10,8"
                        VerticalAlignment="Center" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanRun}"/>
                <Button Grid.Row="1" Grid.Column="0" Content="Debug" Padding="15,2" Margin="10,8"
                        VerticalAlignment="Center" Command="{Binding DebugTestCommand}" IsEnabled="{Binding CanRun}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Stop" Padding="15,2" Margin="10,8"
                        VerticalAlignment="Center" Command="{Binding StopTestCommand}" IsEnabled="{Binding CanStop}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Continue" Padding="15,2" Margin="10,8"
                        VerticalAlignment="Center" Command="{Binding ContinueTestCommand}" IsEnabled="{Binding CanStep}"/>
            </Grid>

            <!-- Status badges + progress -->
            <Grid Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Background="#888" BorderBrush="#222" BorderThickness="1" CornerRadius="3" Width="140" Margin="0,0,10,0">
                    <TextBlock Text="{Binding CompletedTests}" Padding="10,5" Foreground="White" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="1" Background="#2A2" BorderBrush="#151" BorderThickness="1" CornerRadius="3" Width="140" Margin="0,0,10,0">
                    <TextBlock Text="{Binding SucceededTests}" Padding="10,5" Foreground="White" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="2" Background="#F33" BorderBrush="#161" BorderThickness="1" CornerRadius="3" Width="140" Margin="0,0,10,0">
                    <TextBlock Text="{Binding FailedTests}" Padding="10,5" Foreground="White" FontWeight="Bold"/>
                </Border>
                <Border Grid.Column="3" Background="#66F" BorderBrush="#112" BorderThickness="1" CornerRadius="3" Width="140" Margin="0">
                    <TextBlock Text="{Binding SkippedTests}" Padding="10,5,0,5" Foreground="White" FontWeight="Bold"/>
                </Border>
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,5,0,0"
                             Height="10" Value="{Binding TestsCompleted, Mode=OneWay}" Maximum="{Binding NumTests, Mode=OneWay}"/>
            </Grid>

            <Button Grid.Row="1" Grid.Column="3" Content="Logs" HorizontalAlignment="Stretch"
                    Margin="5,25,5,0" VerticalAlignment="Top" Command="{Binding OpenLogsCommand}"/>
        </Grid>

        <!-- Row 5: Column headers -->
        <Grid Grid.Row="5" Grid.ColumnSpan="7" Margin="5,2,5,2" Background="#3A1A1A" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="68"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Status"      FontWeight="Bold" Margin="10,0"/>
            <TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" Margin="10,0"/>
            <TextBlock Grid.Column="3" Text="Command"     FontWeight="Bold" Margin="10,0"/>
            <TextBlock Grid.Column="4" Text="Expected"    FontWeight="Bold" Margin="10,0"/>
            <TextBlock Grid.Column="5" Text="Received"    FontWeight="Bold" Margin="10,0"/>
        </Grid>

        <!-- Row 6: Test list -->
        <ListBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7" Margin="5,2,5,18"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}"
                 x:Name="TestListBox">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:CommandTest">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Status, Converter={StaticResource StatusIcons}}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}"        Margin="5,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Description}"   Margin="5,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Command}"       Margin="5,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding ExpectedReply}" Margin="5,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding ReceivedReply}" Margin="5,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 7: Debug label -->
        <TextBlock Grid.Row="7" HorizontalAlignment="Left" Margin="5,0,0,2" Text="Debug Output"
                   VerticalAlignment="Bottom" FontSize="11" FontWeight="Bold"/>

        <!-- Row 8: Debug output -->
        <ListBox Grid.Row="8" Grid.ColumnSpan="7" Margin="5,2,5,5"
                 FontFamily="Consolas" FontSize="10"
                 ItemsSource="{Binding DebugOutput}"
                 SelectedIndex="{Binding LastLineIndex, Mode=OneWay}"
                 x:Name="DebugListBox"/>
    </Grid>
</Window>
